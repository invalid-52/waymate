# Vercel frontend build variable. Use the same-origin API route.
VITE_API_BASE_URL=/api

# Add these in Vercel Project Settings > Environment Variables (never commit real values).
MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@cluster0.example.mongodb.net/waymate?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=Waymate
CLIENT_ORIGIN=https://your-project.vercel.app
NODE_ENV=production
