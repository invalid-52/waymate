# Local backend development only. Vercel deployment variables belong in Vercel Settings.
MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@cluster0.example.mongodb.net/waymate?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=Waymate
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5000
